  },
  "homepage": "https://github.com/Miqueias-Henrique/WEB-II#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "mysql2": "^3.24.4",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.2",
    "@types/swagger-ui-express": "^4.1.8",
