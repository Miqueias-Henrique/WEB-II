  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:watch": "tsx watch src/server.ts",
    "migration:run": "npm run build && typeorm migration:run -d dist/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/data-source.js",
    "seed:run": "npm run build && node dist/seeds.js",
    "test": "npm run build && node tests/pagination.cjs && node tests/p1.cjs",
    "test:unit": "npm run build && node tests/pagination.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miqueias-Henrique/WEB-II.git"
