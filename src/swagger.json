{
  "openapi": "3.0.0",
  "info": {
    "title": "API WEB II",
    "version": "1.0.0",
    "description": "Documentação da API completa para todos os 5 recursos"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local"
    }
  ],
  "components": {
    "parameters": {
      "pageParam": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        },
        "description": "Número da página"
      },
      "limitParam": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        },
        "description": "Quantidade de registros por página"
      },
      "idParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "description": "ID do recurso"
      }
    },
    "schemas": {
      "PaginatedResult": {
        "type": "object",
        "required": [
          "data",
          "total",
          "page",
          "limit",
          "lastPage"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "lastPage": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
